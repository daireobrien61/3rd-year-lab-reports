%Enviroments for highlighting text in notes. 
\newmdenv[
    backgroundcolor = red!10,
    roundcorner = 5pt,
    innertopmargin = 5pt,
    innerbottommargin=5pt
]{nb}

\newmdenv[
    backgroundcolor = gray!10,
    roundcorner = 5pt,
    innertopmargin = 5pt,
    innerbottommargin=5pt
]{hi}

\mdfdefinestyle{theoremstyle}{
    backgroundcolor = gray!10,
    roundcorner = 5pt,
    innertopmargin = 5pt,
    innerbottommargin=5pt}

\mdtheorem[style=theoremstyle]{example}{Example}

\mdfdefinestyle{equationstyle}{
    backgroundcolor = blue!10,
    roundcorner = 5pt,
    innertopmargin = 5pt,
    innerbottommargin=5pt}

\mdtheorem[style=equationstyle]{eq}{Important Equation}

\mdfdefinestyle{theoremstyle2}{
    backgroundcolor = red!10,
    roundcorner = 5pt,
    innertopmargin = 5pt,
    innerbottommargin=5pt}
\mdtheorem[style=theoremstyle2]{theorem}{Theorem}

% Easy image insert
%   use as \img{imagename}{caption}{label}
%   will insert image with with 70% of textwidth
%   change below for other width
\newcommand{\img}[4]{
    \begin{figure}[!ht]
        \centering
            \includegraphics[width=#4\textwidth]{#1}
        \caption{#2}
        \label{fig:#3}
    \end{figure}
}

